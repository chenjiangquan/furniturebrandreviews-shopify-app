SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
SCOPES=read_products,read_themes,write_themes
SHOPIFY_APP_URL=https://your-tunnel-url.ngrok-free.app
DATABASE_URL=file:./dev.sqlite
DIRECT_DATABASE_URL=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
APP_OWNER_NOTIFICATION_EMAIL=
SHOPIFY_BILLING_TEST=true
FREE_PRO_SHOPS=
SHOPIFY_APP_HANDLE=furniture-brand-reviews

# Supabase/PostgreSQL production:
# DATABASE_URL should use the Supabase transaction pooler for Vercel runtime:
# postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=20
# DIRECT_DATABASE_URL should use the Supabase session pooler or direct connection for migrations:
# postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
# For live merchant billing, leave SHOPIFY_BILLING_TEST unset or set it to false.
# Comma-separated myshopify domains that should receive Pro without Shopify Billing.
# Example: FREE_PRO_SHOPS=furniture-brand-reviews-dev.myshopify.com,another-store.myshopify.com
