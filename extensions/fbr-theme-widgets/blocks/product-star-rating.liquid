{{ 'fbr-widgets.css' | asset_url | stylesheet_tag }}
<script>
  (() => {
    const configuredBase = {{ block.settings.api_base_url | json }}.replace(/\/$/, '');
    const apiBase = configuredBase === '/apps/fbr' ? 'https://app.furniturebrandreviews.com' : configuredBase;
    const url = `${apiBase}/api/product-reviews?shop=${encodeURIComponent({{ shop.permanent_domain | json }})}&productId=${encodeURIComponent({{ product.id | json }})}&productHandle=${encodeURIComponent({{ product.handle | json }})}&productTitle=${encodeURIComponent({{ product.title | json }})}`;
    window.__fbrEarlyFetches = window.__fbrEarlyFetches || {};
    if (!window.__fbrEarlyFetches[url]) {
      window.__fbrEarlyFetches[url] = fetch(url).then(async (response) => {
        const data = await response.json();
        if (!response.ok || data.ok === false) throw new Error(data.error || data.message || 'Request failed');
        return data;
      });
    }
  })();
</script>
<script src="{{ 'fbr-widgets.js' | asset_url }}" defer></script>

<div
  class="fbr-widget"
  style="--fbr-primary: {{ block.settings.primary_color }}; --fbr-star: {{ block.settings.star_color }}; --fbr-radius: {{ block.settings.border_radius }}px;"
  data-fbr-product-stars
  data-api-base="{{ block.settings.api_base_url }}"
  data-shop="{{ shop.permanent_domain }}"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
></div>

{% schema %}
{
  "name": "Star Rating Badge",
  "target": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    { "type": "text", "id": "api_base_url", "label": "App proxy base URL", "default": "/apps/fbr" },
    { "type": "color", "id": "primary_color", "label": "Primary color", "default": "#1f6f64" },
    { "type": "color", "id": "star_color", "label": "Star color", "default": "#f5a623" },
    { "type": "range", "id": "border_radius", "label": "Border radius", "min": 0, "max": 24, "step": 1, "default": 8 }
  ]
}
{% endschema %}
